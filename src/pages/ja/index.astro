---
import { parsePageCopy, serializeInlineJson } from "../../content/page-copy";
import pageCopySource from "../../../data/page.ja.yaml?raw";
import { loadContent, loadScene } from "../../content/load";
import { findPath } from "../../demo/path";
import { renderSignatureSvg } from "../../render/signature";
const content = loadContent(import.meta.env.PROFILE_MODE === "release" ? "release" : "draft");
const scene = loadScene();
const clearance = scene.clearance_presets[1] ?? scene.clearance_presets[0];
const path = findPath(scene, clearance);
if (path.status !== "ok") throw new Error("Signature scene has no valid path");
const copy = parsePageCopy(pageCopySource);
const poster = renderSignatureSvg(scene, path, copy.demo.image_description);
const demoCopy = serializeInlineJson(copy.demo);
const { profile, projects, focus } = content;
const githubUrl = profile.githubUsername ? `https://github.com/${encodeURIComponent(profile.githubUsername)}` : null;
const data = serializeInlineJson({ scene, rawPath: path.rawPath, smoothPath: path.smoothPath, canvasDescription: copy.demo.canvas_description });
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#191b1e" />
    <meta name="description" content={`${profile.displayName ?? ""} — ${profile.headline.ja ?? copy.meta.fallback_headline}`} />
    <meta name="robots" content={content.mode === "draft" ? "noindex, nofollow" : "index, follow"} />
    <title>{profile.displayName ?? copy.meta.fallback_name} — {copy.meta.title_suffix}</title>
  </head>
  <body>
    <a class="skip" href="#main">{copy.navigation.skip}</a>
    <div class="page-shell">
      <header class="masthead">
        <a href={import.meta.env.BASE_URL} class="home-link">{profile.displayName ?? copy.meta.fallback_name}</a>
        <nav aria-label={copy.navigation.label}>
          <a href="#demo">{copy.navigation.demo}</a>
          {githubUrl && <a href={githubUrl} target="_blank" rel="noopener noreferrer">{copy.navigation.github} <span aria-hidden="true">↗</span><span class="sr-only">{copy.navigation.new_tab}</span></a>}
        </nav>
      </header>
      <main id="main">
        <section class="introduction" aria-labelledby="profile-title">
          <div>
            <h1 id="profile-title">{profile.displayName ?? copy.meta.fallback_name}</h1>
            <p class="field">{profile.headline.ja ?? profile.headline.en}</p>
          </div>
          <div class="profile-details">
            {profile.summary.ja && <p class="biography">{profile.summary.ja}</p>}
            {profile.team && <p class="profile-links">{copy.profile.team_label}<a href={profile.team.url} target="_blank" rel="noopener noreferrer">{profile.team.name}<span class="sr-only">{copy.navigation.new_tab}</span></a></p>}
          </div>
        </section>
        <section class="demo-section" id="demo" aria-labelledby="demo-title">
          <div class="section-heading">
            <h2 id="demo-title">{copy.demo.title}</h2>
            <p>{copy.demo.description}</p>
          </div>
          <figure class="signature" data-signature data-animation="static" data-stage="complete">
            <div class="scene-viewport" data-scene-viewport>
              <div class="scene-poster" data-scene-poster set:html={poster}></div>
              <div class="scene-canvas" data-scene-canvas></div>
            </div>
            <figcaption class="scene-caption">
              <div class="stage-track" aria-label={copy.demo.phase_label}>
                <span data-phase="search">{copy.demo.phases.search}</span><span class="stage-connector" aria-hidden="true">→</span>
                <span data-phase="refine">{copy.demo.phases.refine}</span><span class="stage-connector" aria-hidden="true">→</span>
                <span data-phase="playback">{copy.demo.phases.playback}</span>
              </div>
              <div class="playback-footer">
                <p class="scene-status" data-scene-status aria-live="polite">{copy.demo.status.initial}</p>
                <div class="playback-controls" data-playback-controls hidden>
                  <button class="toggle-play" type="button" data-toggle aria-label={copy.demo.controls.play}><span class="play-symbol" data-play-symbol aria-hidden="true">▶</span><span data-play-label>{copy.demo.controls.play}</span></button>
                  <button class="restart" type="button" data-restart aria-label={copy.demo.controls.restart} title={copy.demo.controls.restart}><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 8a6.5 6.5 0 1 1-.3 4M4 3v5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                </div>
              </div>
            </figcaption>
            <script type="application/json" data-signature-copy set:html={demoCopy}></script>
            <script type="application/json" data-signature-data set:html={data}></script>
          </figure>
          <p class="demo-note">{copy.demo.note}{path.fallbackCorners > 0 && ` ${copy.demo.fallback_note}`}</p>
        </section>
        <section class="explanation" aria-labelledby="explanation-title">
          <h2 id="explanation-title">{copy.explanation.title}</h2>
          <dl>
            {copy.explanation.steps.map((step) => <div><dt>{step.title}</dt><dd>{step.body}</dd></div>)}
          </dl>
        </section>

        {projects.length > 0 && <section class="selected-work" id="work" aria-labelledby="work-title">
          <h2 id="work-title">{copy.work.title}</h2>
          <div class="work-list">{projects.map((project) => <article>
            <h3>{project.url ? <a href={project.url} target="_blank" rel="noopener noreferrer">{project.title.ja ?? project.title.en}<span aria-hidden="true"> ↗</span><span class="sr-only">{copy.navigation.new_tab}</span></a> : project.title.ja ?? project.title.en}</h3>
            {project.description && <p>{project.description.ja ?? project.description.en}</p>}
            <div class="work-details">{project.repository && <span>{project.repository}{project.branch && ` / ${project.branch}`}</span>}{project.reference && <a href={project.reference.url} target="_blank" rel="noopener noreferrer">{project.reference.label}<span class="sr-only">{copy.navigation.new_tab}</span></a>}</div>
          </article>)}</div>
        </section>}
        {focus.ja && <section class="focus"><h2>{copy.focus.title}</h2><p>{focus.ja}</p></section>}
      </main>
      <footer><span>{profile.displayName ?? copy.meta.fallback_name}</span>{content.mode === "draft" && <span>{copy.footer.draft}</span>}</footer>
    </div>
    <script>import "../../client/signature-controls";</script>
  </body>
</html>
<style>
  :global(:root) {
    color-scheme: dark;
    --bg: #191b1e;
    --text: #ecece9;
    --muted: #b2b4b7;
    --accent: #aac8e4;
    --line: #393c41;
  }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 24px; background: var(--bg); }
  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Noto Sans CJK JP", Meiryo, sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: var(--accent); text-decoration: none; text-underline-offset: 4px; }
  :global(a:hover) { text-decoration: underline; }
  :global(button) { font: inherit; }
  :global(button:focus-visible), :global(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  :global([hidden]) { display: none !important; }
  :global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .page-shell { max-width: 1080px; margin: auto; padding: 0 40px; }
  .skip { position: fixed; top: 12px; left: 12px; padding: 10px 16px; background: var(--text); color: var(--bg); transform: translateY(-180%); z-index: 10; }
  .skip:focus { transform: none; }
  .masthead { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 72px; border-bottom: 1px solid var(--line); }
  .home-link { font-size: 15px; font-weight: 600; color: var(--text); }
  nav { display: flex; gap: 28px; }
  nav a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 14px; }
  .introduction { display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; align-items: center; padding: 44px 0 40px; }
  h1 { font-size: 34px; font-weight: 600; line-height: 1.3; margin: 0 0 12px; letter-spacing: -.02em; }
  .field { margin: 0; color: var(--muted); font-size: 15px; }
  .biography { margin: 0; font-size: 16px; max-width: 36ch; line-height: 1.9; }
  .profile-links { margin: 12px 0 0; color: var(--muted); font-size: 14px; }
  h2 { margin: 0 0 12px; font-size: 21px; font-weight: 600; line-height: 1.6; }
  h3 { font-size: 18px; font-weight: 600; }
  .section-heading p { font-size: 16px; margin: 0 0 24px; color: var(--muted); }
  .signature { position: relative; min-width: 0; margin: 0; border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
  .scene-viewport { position: relative; height: 520px; background: #0b1116; isolation: isolate; }
  .scene-poster, .scene-canvas { position: absolute; inset: 0; }
  .scene-poster { transition: opacity .6s ease; }
  .scene-poster :global(svg), .scene-canvas :global(canvas) { width: 100%; height: 100%; display: block; }
  .signature[data-renderer="webgl"] .scene-poster { opacity: 0; pointer-events: none; }
  .scene-caption { padding: 16px 22px 12px; background: #202226; border-top: 1px solid var(--line); }
  .stage-track { display: flex; align-items: center; gap: 13px; }
  .stage-track > span:not(.stage-connector) { color: var(--muted); font-size: 13px; transition: color .3s; }
  .stage-connector { color: #85888d; font-size: 12px; }
  .signature[data-stage="search"] [data-phase="search"],
  .signature[data-stage="refine"] [data-phase="refine"],
  .signature[data-stage="playback"] [data-phase="playback"],
  .signature[data-stage="complete"] [data-phase="playback"] { color: var(--text); font-weight: 600; }
  .playback-footer { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 52px; }
  .scene-status { color: var(--muted); font-size: 13px; margin: 8px 0; }
  .playback-controls { display: flex; align-items: center; gap: 8px; }
  .playback-controls button { min-height: 44px; background: transparent; color: var(--text); border: 1px solid transparent; border-radius: 4px; cursor: pointer; }
  .playback-controls button:hover { background: #303339; border-color: #4a4e55; }
  .toggle-play { display: flex; align-items: center; gap: 9px; padding: 0 12px; white-space: nowrap; font-size: 13px; }
  .play-symbol { width: 12px; font-size: 12px; color: var(--muted); }
  .restart { display: grid; place-items: center; width: 44px; }
  .demo-note { color: var(--muted); font-size: 13px; line-height: 1.9; margin: 16px 0 0; }
  .explanation, .selected-work, .focus { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--line); }
  dl { margin: 20px 0 0; }
  dl > div { display: grid; grid-template-columns: 180px 1fr; gap: 28px; padding: 12px 0; }
  dt { font-size: 15px; font-weight: 500; }
  dd { margin: 0; max-width: 65ch; color: var(--muted); font-size: 15px; line-height: 1.9; }
  .work-list { margin-top: 8px; }
  .work-list article { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .work-list article:last-child { border-bottom: 0; padding-bottom: 0; }
  .work-list h3 { margin: 0 0 8px; font-size: 17px; line-height: 1.7; }
  .work-list p { margin: 0; max-width: 76ch; font-size: 15px; color: var(--muted); line-height: 1.9; }
  .work-details { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 10px; font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
  .focus p { font-size: 16px; color: var(--muted); }
  footer { display: flex; justify-content: space-between; gap: 24px; margin-top: 48px; padding: 22px 0 28px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
  @media (max-width: 760px) {
    .page-shell { padding: 0 24px; }
    .masthead { min-height: 64px; }
    nav { gap: 20px; }
    .introduction { grid-template-columns: 1fr; gap: 18px; padding: 30px 0; }
    h1 { font-size: 30px; margin-bottom: 8px; }
    .field { font-size: 14px; }
    .biography { font-size: 15px; max-width: none; }
    h2 { font-size: 20px; }
    .section-heading p { font-size: 15px; margin-bottom: 18px; }
    .scene-viewport { height: clamp(280px, 80vw, 480px); }
    .scene-caption { padding: 14px 14px 10px; }
    .playback-footer { gap: 8px; }
    .scene-status { font-size: 12px; max-width: 19ch; }
    .toggle-play { font-size: 12px; padding: 0 6px; }
    .playback-controls { gap: 2px; }
    dl > div { grid-template-columns: 1fr; gap: 5px; padding: 12px 0; }
    dd { font-size: 15px; }
    .explanation { margin-top: 28px; padding-top: 24px; }
    footer { margin-top: 36px; }
  }
  @media (max-width: 360px) {
    .page-shell { padding: 0 20px; }
    .scene-caption { padding-left: 12px; padding-right: 12px; }
    .playback-footer { flex-wrap: wrap; }
    .scene-status { max-width: none; margin-bottom: 0; }
    .playback-controls { margin-left: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; }
  }
</style>
