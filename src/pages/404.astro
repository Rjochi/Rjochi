---
const title = "Page not found";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · GitHub Profile</title>
    <style>
      :root { color-scheme: light; --background: #f7fafc; --text: #142238; --muted: #42566f; --accent: #006b62; --line: #c3cfdc; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--background); color: var(--text); font-family: ui-sans-serif, system-ui, sans-serif; }
      main { max-width: 720px; margin: 0 auto; padding: 20vh 24px; }
      p { color: var(--muted); }
      a { color: var(--accent); }
      @media (prefers-color-scheme: dark) { :root { color-scheme: dark; --background: #0b1220; --text: #e8eef8; --muted: #a9b8cc; --accent: #5de2d1; --line: #344359; } }
    </style>
  </head>
  <body>
    <main>
      <p>404</p>
      <h1>{title}</h1>
      <p>The requested page does not exist.</p>
      <a href={import.meta.env.BASE_URL}>Return to profile</a>
    </main>
  </body>
</html>